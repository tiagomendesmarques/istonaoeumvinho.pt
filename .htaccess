# www.istonaoeumvinho.pt -> istonaoeumvinho.pt
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.istonaoeumvinho\.pt$ [NC]
  RewriteRule ^ https://istonaoeumvinho.pt%{REQUEST_URI} [R=301,L]
</IfModule>

# Cache
# - HTML: o browser confirma sempre se há versão nova (assim apanha os novos ?v=)
# - CSS/JS: levam ?v=<commit> no endereço, por isso podem ficar em cache 1 ano
# - Imagens e fontes: 1 semana
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|svg|webp|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(txt|xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes
